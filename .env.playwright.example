# Copy this to .env.playwright and fill in both values.
#
# BASE_URL: URL of your running ShelfBridge instance
#   Docker default is http://localhost:9303
#   Local (npm run build && NODE_ENV=production npm start) is http://localhost:3000
BASE_URL=http://localhost:3000
#
# SESSION_COOKIE: your shelfbridge_session cookie value, grabbed from the browser.
#   1. Open your ShelfBridge instance in Chrome/Firefox
#   2. DevTools -> Application -> Cookies -> find "shelfbridge_session"
#   3. Copy the Value column and paste it here
#   Only needed on first run (or when your session expires).
SESSION_COOKIE=
